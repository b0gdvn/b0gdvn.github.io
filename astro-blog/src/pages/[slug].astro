---
export async function getStaticPaths() {
  const postImports = import.meta.glob('../posts/*.md', { eager: true });
  return Object.entries(postImports).map(([path, post]) => {
    const slug = path.split('/').pop().replace(/\.md$/, '');
    return { params: { slug } };
  });
}

const { slug } = Astro.params;
const postImports = import.meta.glob('../posts/*.md', { eager: true });
const post = Object.entries(postImports)
  .map(([path, post]) => {
    const slug = path.split('/').pop().replace(/\.md$/, '');
    return {
      slug,
      ...post.frontmatter,
      Content: post.default,
    };
  })
  .find((entry) => entry.slug === slug);
if (!post) {
  throw new Error('Post not found');
}
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.title} · Blog</title>
    <meta name="description" content={post.description} />
    <style>
      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        background: #111;
        color: #fff;
      }
      .wrapper {
        max-width: 820px;
        margin: 0 auto;
        padding: 3rem 1.5rem;
      }
      a {
        color: #ffcc66;
      }
      h1 {
        margin-top: 0;
      }
      .meta {
        color: #aaa;
        margin-bottom: 2rem;
      }
      .content :global(p) {
        line-height: 1.75;
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <p><a href="/blog/">← Wróć do bloga</a></p>
      <h1>{post.title}</h1>
      <div class="meta">{post.pubDate}</div>
      <div class="content"><post.Content /></div>
      <p><a href="/">Powrót do strony głównej</a></p>
    </div>
  </body>
</html>
